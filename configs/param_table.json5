{
    POST_SCRAPE_OPS: {
        SHAONE: {
            primary: [
                [
                    "normalize_df",
                    "value",
                    "norm_table",
                    "table_html"
                ],
                [
                    "sha1",
                    "value",
                    "SHA_ONE",
                    "pdf"
                ]
            ],
            secondary: [
                [
                    "sha1",
                    "norm_table",
                    "SHA_ONE"
                ]
            ]
        },
    },
    NSE_1: {
        bank_name: "NSE INDIA",
        bank_type: "PUBLIC SECTOR BANKS",
        bank_type_code: "NSE_1",
        base_url: "https://www.nseindia.com/market-data/securities-lending-and-borrowing",
        blocks: [
            {
                action: "api_get",
                by: "tag",
                value: "body",
                default_wait: 2,
                timeout: 10,
                log_message: "Performing API GET request.",
                base_api: {
                    base_url: "https://www.nseindia.com/api/live-analysis-slb",
                    params: {
                        series: [
                            "11",
                            "12",
                            "01",
                            "02",
                            "04",
                            "05",
                            "06",
                            "07",
                            "08",
                            "09",
                            "10",
                            "XN",
                            "XD",
                            "X1",
                            "X2",
                            "X3",
                            "X4",
                            "X5",
                            "X6",
                            "X7",
                            "X8",
                            "X9",
                            "XO"
                        ]
                    }
                },
                domain: ".nseindia.com",
                verify_request: false,
                resp_structure: {
                    api_url: "str|1|string",
                    timestamp: "str|2|string",
                    marketStatus: "dict|3|table",
                    data: "list|4|table"
                },
                null_response: {
                    data: [
                        {
                            symbol: "Null Response from API"
                        }
                    ]
                }
            }
        ],
        headless: true,
        pdf_or_excel: "xlsx"
    },
