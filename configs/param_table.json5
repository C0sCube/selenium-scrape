{
    POST_SCRAPE_OPS: {
        SHAONE: {
            primary: [
                [
                    "normalize_df",
                    "value",
                    "norm_table",
                    "table_html"
                ],
                [
                    "sha1",
                    "value",
                    "SHA_ONE",
                    "pdf"
                ],
            ],
            secondary: [
                [
                    "sha1",
                    "norm_table",
                    "SHA_ONE"
                ]
            ],
        },
    },
    TKR: {
        bank_name: "Ticker Tape",
        bank_type: "Stock Screener",
        bank_type_code: "TKR",
        base_url: "https: //www.tickertape.in",
        base_timeout: 60,
        blocks: [
            {
                action: "weblist",
                by: "tag",
                value: "body",
                default_wait: 10,
                timeout: 20,
                log_message: "Performing webList.",
                web_links: [
                    "https://www.tickertape.in/stocks/ace-software-exports-ACES",
                    "https://www.tickertape.in/stocks/aci-infocom-ACII",
                    "https://www.tickertape.in/stocks/acme-solar-holdings-ACMES",
                    "https://www.tickertape.in/stocks/ln-industries-india-LNI",
                    "https://www.tickertape.in/stocks/ad-manum-finance-ADM",
                    "https://www.tickertape.in/stocks/adc-india-communications-KRO",
                ],
                steps: [
                    {
                        action: "text",
                        by: "tag",
                        value: "body",
                        scrape_fields: {
                            "Company": "css||.security-name",
                            "Index": "css||.text-teritiary.font-medium",
                            "CurrPrice": "css||.typography-h1",
                            "Industry": "css||.stock-label-hover:nth-child(1) .title-text-holder",
                            "MarketCap": "css||.stock-label-hover:nth-child(2) .title-text-holder",
                        },
                        default_wait: 3,
                        timeout: 20,
                    }
                ],
            }
        ],
        headless: true,
        pdf_or_excel: "pdf",
    },
