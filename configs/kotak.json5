{
  POST_SCRAPE_OPS: {
    SHAONE: {
      primary: [
        ["normalize_df", "value", "norm_table", "table_html"],
        ["sha1", "value", "SHA_ONE", "pdf"],
      ],
      secondary: [["sha1", "norm_table", "SHA_ONE"]],
    },
  },

  iNAV_3: {
    bank_name: "KOTAK MF",
    bank_type: "Public Sector",
    bank_type_code: "iNAV_1",
    base_url: "https://www.kotakmf.com/mutual-funds/passive-funds",
    base_timeout: 30,
    blocks: [
      {
        action: "weblist",
        by: "tag",
        value: "body",
        skip_if_not_found: true,
        default_wait: 2,
        timeout: 10,
        log_message: "Performing webList.",
        web_links: [
          "https://www.kotakmf.com/mutual-funds/passive-funds/kotak-nifty-chemicals-etf",
          "https://www.kotakmf.com/mutual-funds/passive-funds/kotak-nifty-next-50-etf",
          "https://www.kotakmf.com/mutual-funds/passive-funds/kotak-nifty200-quality-30-etf",
          "https://www.kotakmf.com/mutual-funds/passive-funds/kotak-nifty-midcap-150-etf",
          "https://www.kotakmf.com/mutual-funds/passive-funds/kotak-nifty-100-equal-weight-etf",
          "https://www.kotakmf.com/mutual-funds/passive-funds/kotak-msci-india-etf",
          "https://www.kotakmf.com/mutual-funds/passive-funds/kotak-nifty-200-momentum-30-etf",
          "https://www.kotakmf.com/mutual-funds/passive-funds/kotak-gold-etf",
          "https://www.kotakmf.com/mutual-funds/passive-funds/kotak-nifty-50-value-20-etf",
          "https://www.kotakmf.com/mutual-funds/passive-funds/kotak-bse-sensex-etf",
          "https://www.kotakmf.com/mutual-funds/passive-funds/kotak-nifty-50-etf",
          "https://www.kotakmf.com/mutual-funds/passive-funds/kotak-nifty-bank-etf",
          "https://www.kotakmf.com/mutual-funds/passive-funds/kotak-nifty-1d-rate-liquid-etf",
          "https://www.kotakmf.com/mutual-funds/passive-funds/kotak-nifty-mnc-etf",
          "https://www.kotakmf.com/mutual-funds/passive-funds/kotak-nifty-india-consumption-etf",
          "https://www.kotakmf.com/mutual-funds/passive-funds/kotak-nifty-alpha-50-etf",
          "https://www.kotakmf.com/mutual-funds/passive-funds/kotak-nifty-it-etf",
          "https://www.kotakmf.com/mutual-funds/passive-funds/kotak-nifty-midcap-50-etf",
          "https://www.kotakmf.com/mutual-funds/passive-funds/kotak-silver-etf",
          "https://www.kotakmf.com/mutual-funds/passive-funds/kotak-nifty-psu-bank-etf",
          "https://www.kotakmf.com/mutual-funds/passive-funds/kotak-nifty-100-low-volatility-30-etf",
        ],
        steps: [
          {
            action: "text",
            by: "tag",
            value: "body",
            scrape_fields: {
              company: "css||#pd_banner .mb-1 span",
              timestamp: "css||#pd_banner span span",
              inav: "css||.nextLine",
            },
            require_title: false,
            multiple: true,
            default_wait: 2,
            timeout: 10,
          },
        ],
      },
    ],
    headless: true,
    pdf_or_excel: "pdf",
  },
  iNAV_1: {
