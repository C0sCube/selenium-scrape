{
  program_config: {
    MAX_REQUEST_BYTE_SIZE: 3000000,
    MAX_DOWNLOAD_TIMEOUT: 30,
    MAX_DOWNLOAD_WAIT: 5,
    DRIVER_LOAD_RETRIES: 5,
    LOAD_IN_BETWEEN_DELAY: 10,
    COOL_DOWN: 30,
    PAGE_LOAD_TIMEOUT:120,
    WEBSITE_LOAD_TIMEOUT:120
  },
  scripts: {
    disable_anim: "const style=document.createElement('style');style.innerHTML='*{animation:none!important;transition:none!important;}';document.head.appendChild(style);",
    remove_modals: "document.querySelectorAll('.modal,.overlay').forEach(e=>e.remove());",
    highlight_clicked: "arguments[0].style.outline='3px solid red';",
    force_clickable: "document.querySelectorAll('*').forEach(e=>{e.style.pointerEvents='auto';e.style.visibility='visible';e.style.opacity='1';e.style.transform='none';});",
  },
  action_text: {
    action: "text",
    by: "tag",
    value: "body",
    scrape_fields: {
      Company: "css||.security-name",
      Index: "css||.text-teritiary.font-medium",
      CurrPrice: "css||.typography-h1",
      Industry: "css||.stock-label-hover:nth-child(1) .title-text-holder",
      MarketCap: "css||.stock-label-hover:nth-child(2) .title-text-holder",
    },
    default_wait: 3,
    timeout: 20,
  },
  action_select: {
    action: "select",
    by: "css",
    value: ".something",
    select_params: {
      options: ["s1|v1|type|csv", "s2|v2|type|csv"],
      btn: "",
    },
    steps: [],
    multiple: true,
    default_wait: 3,
    timeout: 20,
  },
  action_table: {
    action: "table",
    by: "css",
    value: "table",
    wait_until: "present",
    multiple: true,
    skip_if_not_found: true,
    default_wait: 3,
    timeout: 20,
    clean_table: true,
    require_title:true,
    log_message: "Save Html Table(s)",
  },
  action_unclean_table: {
    action: "table",
    by: "css",
    value: "table",
    wait_until: "present",
    multiple: true,
    skip_if_not_found: true,
    default_wait: 3,
    timeout: 20,
    clean_table: false,
    log_message: "Save Html Table(s)",
  },
  action_screenshot: {
    action: "screenshot",
    by: "css",
    value: ".main-content",
    wait_until: "visible",
    skip_if_not_found: true,
    timeout: 20,
    log_message: "Screen Shotted the Web Page.",
  },
  action_download: {
    action: "download",
    by: "css",
    value: "a.FDlink.pdf-data",
    multiple: true,
    wait_until: "clickable",
    default_wait: 5,
    timeout: 20,
    file_save: true,
    log_message: "Axis Bank",
  },
  action_http: {
    action: "http",
    by: "css",
    value: "body",
    log_message: "Downloading file directly via HTTP GET (DLP safe)",
    default_wait: 4,
    timeout: 30,
    file_save: true,
  },
  action_dummy:{
    action:"dummy",
    by: "css",
    value: "body",
  },
  action_website: {
    action: "website",
    by: "css",
    value: "body",
    url: "https://bankofindia.co.in/interest-rate/saving-bank-deposit-rate",
    default_wait: 5,
  },
  action_html: {
    action: "html",
    by: "css",
    value: "body",
    wait_until: "present",
    skip_if_not_found: true,
    default_wait: 10,
    timeout: 30,
    log_message: "Save Html.",
  },
  action_requests: {
    action: "http",
    by: "css",
    value: "body",
    url: "https://eapp.jkbank.com/eintraweb/domestic-rates",
    export_format: "pdf",
    skip_if_not_found: true,
    default_wait: 10,
    timeout: 30,
    log_message: "J&K Bulk Pdf",
  },
  action_click: {
    action: "http",
    by: "css",
    value: "div button",
    default_wait: 10,
    timeout: 30,
    log_message: "J&K Bulk Pdf",
  },
  action_click_save: {
    action: "click_save",
    by: "css",
    value: ".ancr-tg",
    skip_if_not_found: true,
    wait_until: "present",
    default_wait: 3,
    timeout: 15,
  },
  action_tablist: {
    action: "tablist",
    by: "css",
    value: ".tabs-list button",
    skip_if_not_found: true,
    default_wait: 15,
    timeout: 20,
    log_message: "Performing Tab Click.",
    steps: [
      {
        action: "table",
        by: "tag",
        value: "table",
        multiple: true,
        wait_until: "present",
        consolidate_save: true,
        export_format: "html",
        skip_if_not_found: true,
        default_wait: 10,
        timeout: 20,
      },
    ],
  },
  action_weblist: {
    action: "weblist",
    by: "tag",
    value: "body",
    skip_if_not_found: true,
    default_wait: 10,
    timeout: 20,
    log_message: "Performing webList.",
    web_links: [
      "https://www.bankofbaroda.in/interest-rate-and-service-charges/retail-loans-interest-rates",
      "https://www.bankofbaroda.in/interest-rate-and-service-charges/deposits-interest-rates",
    ],
    steps: [
      {
        action: "table",
        by: "tag",
        value: "table",
        multiple: true,
        wait_until: "present",
        consolidate_save: true,
        export_format: "html",
        skip_if_not_found: true,
        default_wait: 10,
        timeout: 20,
      },
    ],
  },
  rep_list: {
    action: "relist",
    by: "css",
    value: ".repeater-list",
    skip_if_not_found: true,
    default_wait: 10,
    timeout: 20,
    log_message: "Performing Repeater List.",
    steps: [
      {
        action: "table",
        by: "tag",
        value: "table",
        multiple: true,
        wait_until: "present",
        consolidate_save: true,
        export_format: "html",
        skip_if_not_found: true,
        default_wait: 10,
        timeout: 20,
      },
    ],
  },
  action_api_get: {
    action: "api_get",
    by: "tag",
    value: "body",
    default_wait: 2,
    timeout: 10,
    log_message: "Performing API GET request.",
    base_api: {
      base_url: "https://www.nseindia.com/api/live-analysis-slb",
      params: {
        series: [
          "11",
          "12",
          "01",
          "02",
          "04",
          "05",
          "06",
          "07",
          "08",
          "09",
          "10",
          "XN",
          "XD",
          "X1",
          "X2",
          "X3",
          "X4",
          "X5",
          "X6",
          "X7",
          "X8",
          "X9",
          "XO",
        ],
      },
    },
    domain: ".nseindia.com",
    verify_request: false,
  },
}
